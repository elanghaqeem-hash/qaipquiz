# Generate a strong random secret (minimum 32 characters) for production.
AUTH_SECRET=replace-with-a-long-random-secret-at-least-32-characters

# Optional: store mutable runtime JSON outside the repository directory.
# Recommended for a single-instance Node deployment with a persistent volume.
QAIP_DATA_DIR=./data

# Bootstrap accounts are created only when data/users.json does not exist.
# Remove these values after the first secure account provisioning if desired.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-strong-unique-password
BOOTSTRAP_ADMIN_NAME=Super Administrator
BOOTSTRAP_ADMIN_EMAIL=

BOOTSTRAP_TRAINER_USERNAME=trainer
BOOTSTRAP_TRAINER_PASSWORD=replace-with-a-strong-unique-password
BOOTSTRAP_TRAINER_NAME=Lead Trainer
BOOTSTRAP_TRAINER_EMAIL=
